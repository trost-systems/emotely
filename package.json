{
  "name": "emotely",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --build",
    "ast-grep:check": "bash scripts/ast-grep.sh test && bash scripts/ast-grep.test.sh && bash scripts/ast-grep.sh",
    "feature-map": "bash scripts/feature-map.test.sh && bash scripts/feature-map.sh",
    "spell": "pnpm run spell:copy && pnpm run spell:us-english",
    "spell:copy": "cspell lint --no-progress --no-summary --no-cache",
    "spell:us-english": "cspell lint --no-progress --no-summary --no-cache --no-config-search --config cspell.us-english.yaml"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-de-de": "4.1.2",
    "cspell": "10.3.6",
    "typescript": "7.0.2"
  }
}
