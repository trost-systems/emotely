# Node / TS
node_modules/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Vercel
.vercel/

# Flutter / Dart
coverage/
.fvm/
# The workspace resolves once at apps/mobile; every member has its own build/.
apps/mobile/.dart_tool/
apps/mobile/**/.dart_tool/
apps/mobile/**/build/
apps/mobile/app/.flutter-plugins
apps/mobile/app/.flutter-plugins-dependencies
apps/mobile/app/ios/Pods/
apps/mobile/app/**/GeneratedPluginRegistrant.*
# Dart tools outside the workspace (tools/emotely_lints) resolve on their own.
tools/*/.dart_tool/
tools/*/build/

# Release signing material — CI materialises these from secrets (ADR 0013)
apps/mobile/app/android/key.properties
*.jks
*.keystore
*.p8
*.mobileprovision
apps/mobile/app/fastlane/report.xml
apps/mobile/app/fastlane/README.md
apps/mobile/app/fastlane/test_output/
apps/mobile/app/vendor/
apps/mobile/app/.bundle/

# Agent worktrees (Claude Code isolation)
.claude/worktrees/

# IDE
.idea/
*.iml

# OS / editor
.DS_Store
*.log
.vercel
.env*
