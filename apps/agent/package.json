{
  "name": "@emotely/agent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build && tsc -p evals",
    "test": "tsc --build && node --test \"src/*.test.ts\"",
    "session": "node src/cli.ts",
    "eval": "tsc --build && node --test \"evals/protocol.eval.ts\"",
    "eval:behavior": "tsc --build && node --test \"evals/behavior.eval.ts\"",
    "benchmark": "tsc --build && node evals/benchmark.ts",
    "build": "tsc --build",
    "smoke": "node scripts/live-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.148",
    "@emotely/contract": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@posthog/ai": "8.14.4",
    "@vercel/functions": "^3.10.2",
    "ai": "7.0.148",
    "jose": "6.2.13",
    "posthog-node": "5.56.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
