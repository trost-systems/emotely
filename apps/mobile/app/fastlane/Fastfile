# frozen_string_literal: true

# Release lanes for the Flutter app (ADR 0013). Everything an agent needs to
# ship a build runs from here; the human steps are the store dashboards.
#
# Two stages per store. Every merge to main lands on the internal stage; the
# beta stage is a deliberate, manual promotion of a build already there.
#
#   bundle exec fastlane ios certificates   one-time / rotation: mint the
#                                           App Store certificate + profile
#                                           into the match repo (needs the
#                                           ASC API key + MATCH_PASSWORD)
#   bundle exec fastlane ios internal       build the IPA and upload it to
#                                           TestFlight; the internal `Team`
#                                           group sees it by itself
#   bundle exec fastlane ios beta           no build: submit the newest (or
#                                           the pinned) processed build for
#                                           Beta App Review and hand it to the
#                                           external `Beta` group
#   bundle exec fastlane android internal   build the AAB and upload it to the
#                                           Play `internal` track
#   bundle exec fastlane android beta       no build: promote the `internal`
#                                           release to the closed `alpha` track
#   bundle exec fastlane ios metadata       no build: upload the App Store
#                                           listing in fastlane/metadata to the
#                                           version in preparation; no
#                                           screenshots, no submission
#   bundle exec fastlane android metadata   no build: upload the Play listing
#                                           in fastlane/metadata/android; no
#                                           images, no release notes
#
# The metadata lanes are the one way a listing changes: edit the files, and
# the store-listings workflow runs them when the change merges. ios metadata
# skips, with a notice, while no App Store version can take a listing, and
# app-release runs it again after every iOS build so a skipped listing
# catches up.
#
# Every Play edit commits with ERROR_IF_IN_REVIEW (fastlane/lib/
# play_review_guard.rb): a commit never cancels and resubmits what Google is
# reviewing.
#
# Inputs, all environment variables (secrets of the `release` environment):
#   APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID / _API_KEY_P8   the ASC API key
#   MATCH_PASSWORD                                            match encryption
#   PLAY_SERVICE_ACCOUNT_JSON                                 Play upload account
#   POSTHOG_KEY                                               analytics token
#   BUILD_NUMBER                                              monotonic build id
#                                                             (internal lanes)
#   PROMOTE_BUILD_NUMBER                                      optional: the
#                                                             build to promote
#                                                             (beta lanes);
#                                                             newest if unset

require_relative "lib/play_review_guard"
require_relative "lib/app_store_listing"

# The rebuild starts at 2.0.0 (ADR 0012): the legacy app got to 1.21.15.
BUILD_NAME = "2.0.0"

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

# The build a beta lane promotes, or nil for "the newest one".
def promote_build_number
  value = ENV.fetch("PROMOTE_BUILD_NUMBER", "").strip
  value.empty? ? nil : value
end

# Hands the build a lane just shipped to the workflow step running it, as the
# step outputs `version` and `build`; app-release.yml's `status` job turns them
# into the README badges. A no-op outside GitHub Actions.
def report_shipped(version:, build:)
  outputs = ENV.fetch("GITHUB_OUTPUT", "")
  return if outputs.empty?

  File.open(outputs, "a") { |file| file.puts("version=#{version}", "build=#{build}") }
end

def dart_defines
  defines = []
  defines << "--dart-define=POSTHOG_KEY=#{ENV.fetch("POSTHOG_KEY")}" if ENV["POSTHOG_KEY"].to_s != ""
  defines
end

# apps/mobile/app. Lanes run from here, but `sh` runs inside fastlane/, so the
# flutter command gets an explicit `cd`.
APP_DIR = File.expand_path("..", FastlaneCore::FastlaneFolder.path)

# The store listings, English and German, in deliver's layout; Play's under
# android/ in supply's. scripts/store-listing-check.sh guards their limits.
METADATA_DIR = File.join(FastlaneCore::FastlaneFolder.path, "metadata")

def flutter(*args)
  require "shellwords"
  sh("cd #{Shellwords.escape(APP_DIR)} && flutter #{Shellwords.join(args)}")
end

# Shown to beta testers as "What to Test". Static: every build is the same ask.
BETA_CHANGELOG = <<~TEXT.strip
  emotely is an evening journaling assistant. Please write an entry on a
  few evenings — ideally on different days, so you see how it picks up
  where you left off. Anything that felt off, confusing or slow is worth
  reporting: tap "Send feedback" on the account screen.
TEXT

platform :ios do
  APP_IDENTIFIER = "de.emotely.emotely"
  BETA_GROUP = "Beta"

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )
  end

  desc "Mint (or rotate) the App Store signing certificate and profile into the match repo"
  lane :certificates do
    match(type: "appstore", readonly: false, api_key: asc_api_key)
  end

  desc "Build the release IPA, signed with what match holds (no upload)"
  lane :build do
    api_key = asc_api_key
    # On CI, a throwaway keychain that match can import into.
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: api_key)

    # Xcode signs manually with what match installed; CODE_SIGN_STYLE in the
    # project stays Automatic for local development.
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "VCZSHMZY25",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: ENV.fetch("sigh_de.emotely.emotely_appstore_profile-name"),
      targets: ["Runner"]
    )

    flutter(
      "build", "ipa", "--release",
      "--build-name=#{BUILD_NAME}", "--build-number=#{build_number}",
      "--export-options-plist=fastlane/ExportOptions.plist",
      *dart_defines
    )

    ipa = Dir.glob(File.join(APP_DIR, "build/ios/ipa/*.ipa")).first
    UI.user_error!("no IPA under build/ios/ipa") if ipa.nil?
    lane_context[:IPA_OUTPUT_PATH] = ipa
  end

  desc "Install match's App Store certificate and profile for the performance survey's XCTest build (Test Lab re-signs it); no build"
  lane :survey_signing do
    # On CI, a throwaway keychain that match can import into.
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key)
    # survey.sh signs with the profile's certificate (`build ios --profile`).
    profile = ENV.fetch("sigh_de.emotely.emotely_appstore_profile-path")
    File.open(ENV["GITHUB_ENV"], "a") { |file| file.puts("SURVEY_PROFILE=#{profile}") } if ENV["GITHUB_ENV"]
  end

  desc "Build the release IPA and upload it to TestFlight for the internal Team group"
  lane :internal do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: lane_context[:IPA_OUTPUT_PATH],
      app_identifier: APP_IDENTIFIER,
      # No groups, no external distribution, no Beta App Review submission:
      # the internal `Team` group has "access to all builds" in App Store
      # Connect and picks the build up once Apple has processed it. With a
      # changelog, pilot waits only until the build appears (a few minutes,
      # not the 10-30 min of processing), sets "What to Test" and returns.
      skip_waiting_for_build_processing: true,
      changelog: BETA_CHANGELOG
      # Deliberately not set: `uses_non_exempt_encryption` (Info.plist
      # already carries ITSAppUsesNonExemptEncryption=false) and
      # `expire_previous_builds` (testers keep the older build until they
      # update).
    )
    report_shipped(version: BUILD_NAME, build: build_number)
  end

  # Queries below need Spaceship's token, which `asc_api_key` sets
  # (set_spaceship_token defaults to true).

  def asc_app
    @asc_app ||= Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  end

  # The build of this version Apple is still reviewing, or nil. Apple takes
  # one Beta App Review submission per train (= version) at a time; a second
  # one is refused with "Another build in the same train is already in beta
  # review" (run 35511874404), and pilot submits *before* it assigns groups,
  # so that refusal fails the whole distribution. Same filter pilot uses for
  # reject_build_waiting_for_review.
  def build_in_beta_review
    asc_app.get_builds(
      filter: {
        "betaAppReviewSubmission.betaReviewState" => "WAITING_FOR_REVIEW,IN_REVIEW",
        "expired" => false,
        "preReleaseVersion.version" => BUILD_NAME
      },
      includes: "betaAppReviewSubmission,preReleaseVersion"
    ).first
  end

  # The newest unexpired build of this version, narrowed by more build
  # filters (`filter[betaGroups]` is how the API answers "which builds does
  # this group have"; the Build model carries no groups), or nil. One page
  # of one through the client: App#get_builds walks every page whatever the
  # limit (fastlane #16398), which grows with each upload.
  def newest_build(**filter)
    Spaceship::ConnectAPI.get_builds(
      filter: { app: asc_app.id, "expired" => false, "preReleaseVersion.version" => BUILD_NAME }.merge(filter),
      # The client's default adds `betaBuildMetrics`, which Apple no longer
      # accepts as a relationship ("not a valid relationship name").
      includes: "buildBetaDetail",
      sort: "-uploadedDate",
      limit: 1
    ).to_models.first
  end

  def beta_group
    asc_app.get_beta_groups(filter: { name: BETA_GROUP })
           .find { |group| group.name == BETA_GROUP } ||
      UI.user_error!("App Store Connect has no TestFlight group named #{BETA_GROUP}")
  end

  desc "No build: submit the newest (or PROMOTE_BUILD_NUMBER) processed build for Beta App Review and distribute it to the Beta group"
  lane :beta do
    api_key = asc_api_key

    wanted = { "processingState" => "VALID" }
    wanted["version"] = promote_build_number if promote_build_number
    build = newest_build(**wanted)
    UI.user_error!("App Store Connect has no processed build #{promote_build_number || "of #{BUILD_NAME}"}") if build.nil?

    # Before the review check, so a rerun for a build that is already in
    # the group (including the one under review) is a no-op, not a failure.
    if newest_build("version" => build.version, "betaGroups" => beta_group.id)
      UI.success("#{BUILD_NAME} - #{build.version} is already in #{BETA_GROUP}; nothing to promote")
      next
    end

    blocking = build_in_beta_review
    if blocking
      UI.user_error!(
        "Build #{blocking.app_version} - #{blocking.version} is still in Beta App Review; " \
        "Apple takes one submission per version at a time. Try again once it is approved."
      )
    end

    # pilot's `distribute` mode: no ipa, the build is looked up by number.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_only: true,
      # With no ipa to read it from, pilot prompts for the platform, which
      # crashes a non-interactive run (run 35530701943).
      app_platform: "ios",
      app_version: BUILD_NAME,
      build_number: build.version,
      distribute_external: true,
      # Only the external group, by exact name. The internal `Team` group
      # has "access to all builds" turned on in App Store Connect, so every
      # build reaches it on its own, and naming it here is rejected by Apple
      # ("Builds cannot be assigned to this internal group", run 35510026821).
      # `distribute_external` without `groups` is a hard error in pilot, and
      # a changelog is required with it.
      groups: [BETA_GROUP],
      changelog: BETA_CHANGELOG,
      notify_external_testers: true
      # submit_beta_review defaults to true: pilot submits every build whose
      # external state is READY_FOR_BETA_SUBMISSION, which every processed
      # build is until submitted. Apple reviews the first build of a version
      # and auto-approves later ones within minutes.
      #
      # Deliberately not set: `beta_app_review_info` (contact + demo account
      # already live in App Store Connect, and passing it would overwrite
      # them on every run) and `reject_build_waiting_for_review` (it expires
      # the build under review and resubmits; the check above refuses
      # instead, so a pending first review is never restarted by accident).
    )
  end

  desc "No build: upload the App Store listing (fastlane/metadata) to the version in preparation, or skip with a notice"
  lane :metadata do
    api_key = asc_api_key

    # deliver writes to the version in preparation. Without one, or while
    # Apple reviews it, the lane skips with a notice and stays green: the
    # listing goes up the next time it runs (app-release runs it after every
    # iOS build). The version record comes from the ASC prep, see the
    # release-app skill.
    version = asc_app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    state = version && (version.app_version_state || version.app_store_state)
    skip = AppStoreListing.skip_reason(version&.version_string, state)
    if skip
      AppStoreListing.notice(skip)
      next
    end

    # deliver sets phased release and a ratings reset to its defaults (both
    # off) whenever it uploads metadata, deleting either if it exists. A
    # listing change must not change how the version is released, so the
    # lane passes on what App Store Connect already holds.
    phased_release = begin
      !version.fetch_app_store_version_phased_release.nil?
    rescue StandardError
      false
    end
    reset_ratings = begin
      !version.fetch_reset_ratings_request.nil?
    rescue StandardError
      false
    end

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      metadata_path: METADATA_DIR,
      skip_binary_upload: true,
      skip_screenshots: true,
      # The version in preparation keeps its number; deliver neither creates
      # nor renames one.
      skip_app_version_update: true,
      submit_for_review: false,
      phased_release: phased_release,
      reset_ratings: reset_ratings,
      # The pull request that changed the files was the review; deliver's
      # HTML preview would wait for a keypress on a non-interactive run.
      force: true,
      # precheck's in-app purchase check needs an Apple ID, not an API key,
      # and nothing is submitted here.
      run_precheck_before_submit: false
      # Deliberately absent: review information (it holds the demo account's
      # password and stays in App Store Connect), App Privacy (Apple takes it
      # through the console only) and screenshots.
    )
  end
end

platform :android do
  PACKAGE_NAME = "de.emotely.emotely"

  def play_store_defaults
    {
      package_name: PACKAGE_NAME,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
  end

  desc "Build the release App Bundle and upload it to the Play internal track"
  lane :internal do
    flutter(
      "build", "appbundle", "--release",
      "--build-name=#{BUILD_NAME}", "--build-number=#{build_number}",
      *dart_defines
    )

    # Instant dogfood, no Google review.
    upload_to_play_store(
      **play_store_defaults,
      track: "internal",
      aab: File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab")
    )
    report_shipped(version: BUILD_NAME, build: build_number)
  end

  desc "No build: promote the internal release (or PROMOTE_BUILD_NUMBER) to the closed alpha track"
  lane :beta do
    # The closed track `alpha` ("Closed testing - Alpha" in the console,
    # testers = the "emotely beta" list). Google reviews closed-testing
    # releases, so it does not go live for testers immediately.
    #
    # A binary-free edit on purpose: supply ignores `track_promote_to`
    # whenever it uploaded a binary in the same edit (perform_upload only
    # reaches promote_track in the `else` of `if uploading_new_binaries`,
    # supply/lib/supply/uploader.rb). Without `version_code` supply takes the
    # internal track's one completed release, i.e. the newest upload.
    upload_to_play_store(
      **play_store_defaults,
      skip_upload_aab: true,
      track: "internal",
      track_promote_to: "alpha",
      **(promote_build_number ? { version_code: Integer(promote_build_number) } : {})
    )
  end

  desc "No build: upload the Play listing (fastlane/metadata/android): title and descriptions"
  lane :metadata do
    # A binary-free edit that writes the listing text only. supply looks up
    # a release on `track` even when it uploads no release notes, and
    # `internal` has exactly one (the beta lane relies on the same); without
    # binaries, a promotion or a rollout it leaves every track as it is.
    upload_to_play_store(
      play_store_defaults.merge(
        skip_upload_metadata: false,
        skip_upload_aab: true,
        skip_upload_apk: true,
        track: "internal",
        metadata_path: File.join(METADATA_DIR, "android")
      )
    )
  end
end
