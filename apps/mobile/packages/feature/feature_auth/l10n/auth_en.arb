{
  "@@locale": "en",
  "signUpTitle": "Almost there",
  "@signUpTitle": {
    "description": "Sign-in screen heading when it is the last step of onboarding and the user skipped telling us their name. The account is about to be created."
  },
  "signUpTitleWithName": "Almost there, {name}",
  "@signUpTitleWithName": {
    "description": "Sign-in screen heading when it is the last step of onboarding, greeting the user by the name they typed a step earlier. The account is about to be created.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Peter"
      }
    }
  },
  "signUpBody": "Create your account so your reflections stay safe – and with you on any phone.",
  "@signUpBody": {
    "description": "Sign-in screen, last step of onboarding: under the heading, why the user should create an account now. \"Reflections\" are the user's journal entries."
  },
  "signInTitle": "Welcome back",
  "@signInTitle": {
    "description": "Sign-in screen heading when a returning user tapped \"I have an account\" on the welcome screen."
  },
  "privacyNoticeButton": "Privacy notice",
  "@privacyNoticeButton": {
    "description": "Sign-in screen, link at the bottom that opens emotely's privacy notice in the browser, reachable before an account exists."
  },
  "appleButton": "Continue with Apple",
  "@appleButton": {
    "description": "Sign-in screen, iOS only: the title of the Sign in with Apple button, after Apple's logo. Apple allows only its own titles: use Apple's official translation of \"Continue with Apple\" in the target language, never a free one."
  },
  "googleButton": "Continue with Google",
  "@googleButton": {
    "description": "Sign-in screen: the title of the Sign in with Google button, after Google's \"G\". Google allows only its own labels: use Google's official translation of \"Continue with Google\" in the target language, never a free one."
  },
  "lastUsedTag": "Last used",
  "@lastUsedTag": {
    "description": "Sign-in screen: a small pill on the edge of the sign-in button the user used last on this phone (Apple, Google or the email and password), to remind them which one they picked. Keep it very short."
  },
  "lastUsedButton": "{button}, last used",
  "@lastUsedButton": {
    "description": "Sign-in screen: what a screen reader announces for the sign-in button the user used last on this phone, the button's own label followed by the \"Last used\" pill's words.",
    "placeholders": {
      "button": {
        "type": "String",
        "example": "Continue with Google"
      }
    }
  },
  "orWithEmail": "or with your email",
  "@orWithEmail": {
    "description": "Sign-in screen: a small label in a horizontal rule between the Apple and Google buttons above and the email and password fields below. Lower case: it continues the buttons above it."
  },
  "emailLabel": "Email address",
  "@emailLabel": {
    "description": "Sign-in screen: the label of the field for the account's email address."
  },
  "emailHint": "you@example.com",
  "@emailHint": {
    "description": "Sign-in screen: the example shown in the empty email field. Keep the reserved domain example.com; only the part before the @ may change, to the target language's \"you\"."
  },
  "passwordLabel": "Password",
  "@passwordLabel": {
    "description": "Sign-in screen: the label of the password field, under the email field, both when signing in and when creating an account."
  },
  "newPasswordLabel": "New password",
  "@newPasswordLabel": {
    "description": "Sign-in screen, resetting a forgotten password: the label of the field for the password the account will have from now on."
  },
  "passwordRule": "At least {count} characters",
  "@passwordRule": {
    "description": "Sign-in screen: the help line under a password field whenever the user chooses a password (a new account, a reset). There is no other rule: any characters count.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "10"
      }
    }
  },
  "showPassword": "Show password",
  "@showPassword": {
    "description": "Sign-in screen: what a screen reader announces for the eye button at the end of a password field, which shows the password as typed."
  },
  "hidePassword": "Hide password",
  "@hidePassword": {
    "description": "Sign-in screen: what a screen reader announces for the eye button at the end of a password field while the password is shown, which hides it again."
  },
  "signInButton": "Sign in",
  "@signInButton": {
    "description": "Sign-in screen, \"I have an account\": the button under the email and password that signs in."
  },
  "createAccountButton": "Create account",
  "@createAccountButton": {
    "description": "Sign-in screen, last step of onboarding: the button under the email and password that creates the account. A code to confirm the address is mailed next."
  },
  "forgotPasswordButton": "Forgot password?",
  "@forgotPasswordButton": {
    "description": "Sign-in screen: a small button under the sign-in button that mails a code to the address typed above, to choose a new password."
  },
  "confirmationSentMessage": "We sent a code to {email}. Enter it to confirm your address and open your account.",
  "@confirmationSentMessage": {
    "description": "Sign-in screen, after creating an account: tells the user a six-digit code is on its way to their address, above the field to type it into. The account opens once the code is typed.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "you@example.com"
      }
    }
  },
  "resetSentMessage": "If there is an account for {email}, we sent it a code. Enter the code and choose a new password.",
  "@resetSentMessage": {
    "description": "Sign-in screen, after \"Forgot password?\": a six-digit code is on its way if the address has an account (the screen cannot know), above the fields for the code and the new password.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "you@example.com"
      }
    }
  },
  "codeLabel": "Code",
  "@codeLabel": {
    "description": "Sign-in screen: the label of the field for the six-digit code from the email."
  },
  "confirmButton": "Confirm",
  "@confirmButton": {
    "description": "Sign-in screen, after creating an account: button that checks the code just typed and opens the account."
  },
  "savePasswordButton": "Save password",
  "@savePasswordButton": {
    "description": "Sign-in screen, resetting a forgotten password: button that saves the new password and signs in."
  },
  "resendCodeButton": "Send a new code",
  "@resendCodeButton": {
    "description": "Sign-in screen, at a code step: button that mails a fresh code, for a mail that did not arrive or a code that expired."
  },
  "codeResentMessage": "A new code is on its way.",
  "@codeResentMessage": {
    "description": "Sign-in screen, at a code step: confirms that \"Send a new code\" worked."
  },
  "newPasswordPrompt": "Choose a new password for {email}.",
  "@newPasswordPrompt": {
    "description": "Sign-in screen, resetting a forgotten password: shown when the code was right but the new password could not be saved, so the user picks it once more.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "you@example.com"
      }
    }
  },
  "changeEmailButton": "Use a different email",
  "@changeEmailButton": {
    "description": "Sign-in screen, at a code step: button that goes back to the email and password to type another address."
  },
  "tooManyCodesMessage": "Too many codes were requested. Please try again later.",
  "@tooManyCodesMessage": {
    "description": "Sign-in screen error: the sign-in service refused to mail another code because too many were sent recently."
  },
  "tooManyAttemptsMessage": "Too many attempts. Wait a few minutes and try again.",
  "@tooManyAttemptsMessage": {
    "description": "Sign-in screen error, any step: the sign-in service is rate-limiting this device. What the user typed may well be right, so it must not sound like a wrong code or password."
  },
  "couldNotSendMessage": "Could not send a mail to that address. Check it and try again.",
  "@couldNotSendMessage": {
    "description": "Sign-in screen error: the sign-in service refused to mail the address typed (to create an account, or for a code), most likely because it is not a real address."
  },
  "wrongCodeMessage": "That code is wrong or has expired. Send a new one if needed.",
  "@wrongCodeMessage": {
    "description": "Sign-in screen error, at a code step: the six-digit code the user typed was not accepted. \"Send a new one\" points at the \"Send a new code\" button."
  },
  "wrongPasswordMessage": "That email and password don’t match an account. Check both, or reset your password.",
  "@wrongPasswordMessage": {
    "description": "Sign-in screen error: the email and password did not sign in. The service does not say which of the two is wrong, so neither may be blamed alone. \"Reset your password\" points at \"Forgot password?\"."
  },
  "weakPasswordMessage": "That password is too short. Use at least {count} characters.",
  "@weakPasswordMessage": {
    "description": "Sign-in screen error: the sign-in service refused a new password as too weak.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "10"
      }
    }
  },
  "accountExistsMessage": "There is already an account for this email. Enter its password, or reset it.",
  "@accountExistsMessage": {
    "description": "Sign-in screen error, last step of onboarding: the user tried to create an account for an address that has one, and the password typed is not that account's. \"Reset it\" points at \"Forgot password?\"."
  },
  "passwordNotSavedMessage": "Your new password could not be saved. Try again.",
  "@passwordNotSavedMessage": {
    "description": "Sign-in screen error, resetting a forgotten password: the code was right, but saving the new password failed."
  },
  "unreachableMessage": "Could not reach the sign-in service.",
  "@unreachableMessage": {
    "description": "Sign-in screen error, any step: no answer from the sign-in service at all (offline, timeout)."
  },
  "providerFailedMessage": "That sign-in did not go through. Try again, or use your email.",
  "@providerFailedMessage": {
    "description": "Sign-in screen error: signing in with Apple or Google failed (not a dismissal). The email and password below are the other way in."
  },
  "humanCheckFailedMessage": "I couldn’t confirm that a person is asking. Try again in a moment.",
  "@humanCheckFailedMessage": {
    "description": "Sign-in screen error: the invisible security check that runs before an account is created, a password is checked or a code is mailed (Cloudflare Turnstile) failed, or the sign-in service refused its result. Nothing the user typed is wrong, so it must not sound like a wrong address or password; trying again runs a fresh check. emotely speaks as \"I\"."
  }
}
