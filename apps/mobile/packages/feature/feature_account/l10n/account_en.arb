{
  "@@locale": "en",
  "consentTitle": "Before emotely sends your writing",
  "@consentTitle": {
    "description": "Consent screen heading, shown before the first journaling session. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it (in any language) means bumping consentVersion. Names the moment rather than asking a question, and stays true when the screen is shown again after a wording change or a withdrawal, neither of which is a 'first' session."
  },
  "consentSendingLead": "Your answers are sent to an AI model.",
  "@consentSendingLead": {
    "description": "Consent screen, first of three points: its bold lead, followed in the same sentence by consentSendingBody. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentSendingBody": "Each answer goes to our server and on to a language model provider through the Vercel AI Gateway, together with the name you chose, or the nickname emotely picked for you, so emotely can ask the next question, address you by name and write your entry. The provider may be outside the EU; where it is, the transfer rests on the EU’s standard contractual clauses.",
  "@consentSendingBody": {
    "description": "Consent screen, first point, after its lead: what is sent, to whom, and the third-country transfer with its safeguard (EDPB 05/2020 para 64 (vi)). Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion. The recipients must match the privacy notice at getemotely.com/app-privacy: same recipients, same order, same names. 'Vercel AI Gateway' is a product name and stays as is."
  },
  "consentRetentionLead": "Never used for training, never kept.",
  "@consentRetentionLead": {
    "description": "Consent screen, second of three points: its bold lead, followed by consentRetentionBody. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentRetentionBody": "Every request routes only to providers contractually barred from training on what you write and from keeping it after they answer. Your entries themselves are stored in Frankfurt and nowhere else.",
  "@consentRetentionBody": {
    "description": "Consent screen, second point, after its lead: what the model provider may not do with the text, and where entries are stored. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion. Must agree with the privacy notice at getemotely.com/app-privacy."
  },
  "consentWithdrawalLead": "Sensitive, and yours to take back.",
  "@consentWithdrawalLead": {
    "description": "Consent screen, third of three points: its bold lead, followed by consentWithdrawalBody. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentWithdrawalBody": "A journal can say how you feel, how you sleep or how your health is, so we ask first. You can withdraw on the More tab at any time; what a provider has already answered cannot be recalled.",
  "@consentWithdrawalBody": {
    "description": "Consent screen, third point, after its lead: why the data is special-category, and that consent can be withdrawn (Art. 7 (3) GDPR). 'More' is the name of the app's second bottom tab and must match it. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentCheckboxLabel": "I consent to my journal entries being sent to a model provider as described above.",
  "@consentCheckboxLabel": {
    "description": "Consent screen: the label of the checkbox, which is the affirmative act itself and always starts unticked. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentAgreeButton": "Start journaling",
  "@consentAgreeButton": {
    "description": "Consent screen button that records the consent; enabled only once the checkbox is ticked. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentDeclineButton": "Not now",
  "@consentDeclineButton": {
    "description": "Consent screen button that declines and goes back to the journal, which stays usable. Named plainly, because the choice has to be real. Also leaves the screen after a consent could not be recorded. Part of the versioned wording of the explicit consent under Art. 9 (2) (a) GDPR: changing it means bumping consentVersion."
  },
  "consentAgreeBlockedHint": "Tick the box above to continue",
  "@consentAgreeBlockedHint": {
    "description": "Consent screen: read out by a screen reader on the disabled agree button, so someone who cannot see the checkbox knows why the button does nothing. An instruction for operating the screen, not a term agreed to: not part of the versioned wording."
  },
  "consentDeclinedMessage": "No problem. Nothing has been sent. You can still read the entries you already have, and you can start a session whenever you decide to.",
  "@consentDeclinedMessage": {
    "description": "Snack bar on the journal after the user declined consent: there is no session without the model, but everything else stays usable."
  },
  "consentReadNoticeLink": "Read the full privacy notice",
  "@consentReadNoticeLink": {
    "description": "Consent screen link that opens the full privacy notice in the browser (the notice itself is in English)."
  },
  "consentFailureMessage": "Could not record your consent. Check your connection and try again.",
  "@consentFailureMessage": {
    "description": "Consent screen, and a snack bar on the journal: the consent could not be recorded on the server, so no session starts."
  },
  "consentWithdrawFailureMessage": "Could not withdraw your consent. Check your connection and try again.",
  "@consentWithdrawFailureMessage": {
    "description": "Privacy settings, under the journal sessions switch: withdrawing consent could not be recorded, so consent still stands."
  },
  "consentUnknownMessage": "Could not check whether you have already agreed to this. Nothing has been sent. Check your connection and try again.",
  "@consentUnknownMessage": {
    "description": "Consent screen and Privacy settings: the app could not find out whether consent already stands. Not the same as 'you have not consented'."
  },
  "consentRetryButton": "Try again",
  "@consentRetryButton": {
    "description": "Consent screen button, after reading or recording the consent failed: tries the same thing again."
  },
  "consentBackButton": "Back",
  "@consentBackButton": {
    "description": "Consent screen button after whether consent stands could not be read: leaves the screen without answering, since nothing was asked."
  },
  "usageAnalyticsTitle": "May I count how you use the app?",
  "@usageAnalyticsTitle": {
    "description": "First-launch sheet heading: the usage-analytics question (PostHog, consent under § 25 TDDDG and Art. 6 (1) (a) GDPR). The companion speaks as 'I'. Part of the versioned usage-analytics wording: changing it means bumping usageAnalyticsVersion."
  },
  "usageAnalyticsBody": "It shows which screens help and where people get stuck, so I can get better. What you write never goes into it.",
  "@usageAnalyticsBody": {
    "description": "First-launch sheet, under the question: why, in one breath. Part of the versioned usage-analytics wording: changing it means bumping usageAnalyticsVersion."
  },
  "usageAnalyticsCounted": "Taps, screens and crash reports, stored with PostHog in the EU",
